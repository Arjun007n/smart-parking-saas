# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
# development = on your own computer only. test = automatic tests. production = the real server.
# Any other value, or none, is treated as production (stricter checks). In development mode the server must stay on
# this computer: never open it to a network or the internet.
NODE_ENV=development

# Local MongoDB, or your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/smart_parking

# Long random text, at least 32 characters (production refuses to start with less). Generate one with:
#   node scripts/generateSecret.js
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Address of the React app (used for CORS and password reset links)
# The web app address(es) allowed to call this API (comma separated for several). Required, and https, in production.
# The Android app (mobile/) also needs its own page address here: https://localhost for a release, http://localhost in test mode.
# Put the website's address first (it is used in email links).
CLIENT_URL=http://localhost:5173

# Login/register attempts allowed per IP every 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Used only by "npm run seed:admin" to create the platform Super Admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Used only by "npm test". The database name must end with _test because
# the tests delete everything in it.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/smart_parking_test

# Local time of your parking sites, in minutes ahead of UTC (India = 330).
# Used for overnight charges and weekday tariffs.
APP_UTC_OFFSET_MINUTES=330

# Online payments (QR / link at the exit). Cash, UPI and card recorded by the
# operator always work; online payment stays off until a gateway is set up.
#
# PAYMENT_PROVIDER chooses the gateway:
#   generic    (default) any gateway that can call our signed webhook; needs
#              PAYMENT_WEBHOOK_SECRET (16+ characters)
#   simulated  a pretend gateway to try the screens, no real money; never in production
#   razorpay   Razorpay payment links; needs the three RAZORPAY_ values below
PAYMENT_PROVIDER=generic
PAYMENT_WEBHOOK_SECRET=

# Razorpay (only when PAYMENT_PROVIDER=razorpay). Use Razorpay TEST keys first.
# Webhook URL to add in the Razorpay dashboard: https://<your-api>/api/payments/webhook
# with the event "payment_link.paid" and the secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The same webhook also confirms plan purchases (Billing page). One webhook, one event, one secret.

# Minutes a customer has to pay online before the payment is closed (5-120)
GATEWAY_PAYMENT_MINUTES=20

# The public address of this API, used in the downloadable gate agent's config.json.
# Leave empty to use the address the admin's browser reached the API on.
PUBLIC_API_URL=
# Folder the "Download gate agent" button packs (default: the gate-agent folder next to server).
GATE_AGENT_DIR=

# Vehicle photos taken at the gate are stored as files in this folder (default:
# server/uploads/photos). On a host that wipes its disk when you redeploy, point
# this at a persistent volume. Photos older than PHOTO_RETENTION_DAYS are deleted.
PHOTO_STORAGE_DIR=
PHOTO_RETENTION_DAYS=90
# Largest accepted picture in bytes (the browser shrinks pictures first)
PHOTO_MAX_BYTES=1572864

# Email (password reset links and alert emails to admins). Off until a sender is chosen.
#   none       (default) switched off; alerts stay in the app
#   simulated  nothing is sent; messages are printed in the server log (never in production)
#   resend     Resend (https://resend.com): needs RESEND_API_KEY and EMAIL_FROM
EMAIL_PROVIDER=none
RESEND_API_KEY=
# An address on a domain you verified at Resend, for example: Smart Parking <alerts@yourdomain.com>
# While testing you can use onboarding@resend.dev, which delivers only to your own Resend account address.
EMAIL_FROM=
# Optional: where replies go
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=8000
# Most alert emails one company can cause per hour (protects against floods)
EMAIL_ALERT_HOURLY_CAP=30

# Text messages: SMS and WhatsApp (alerts to admins, entry/exit notes and pass/booking notes to customers).
# Off until a sender is chosen.
#   none       (default) switched off
#   simulated  nothing is sent; messages are printed in the server log (never in production)
#   twilio     Twilio (https://www.twilio.com): needs the account SID, auth token and a sender
# India: SMS to Indian numbers needs DLT registration of your sender and templates (Twilio explains how).
# WhatsApp: messages you start outside a customer's 24-hour window need a template approved by WhatsApp.
MESSAGING_PROVIDER=none
# sms, whatsapp or both: sms,whatsapp
MESSAGING_CHANNELS=sms
# Added to numbers written without a country code (91 = India)
MESSAGING_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender: a number you own in Twilio, or a Messaging Service SID (one of the two)
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp sender, for example whatsapp:+14155238886 (the Twilio sandbox)
TWILIO_WHATSAPP_FROM=
MESSAGING_TIMEOUT_MS=8000
# Most alert texts one company can cause per hour (protects against floods and cost)
MESSAGING_ALERT_HOURLY_CAP=20
# on (default) or off: the entry/exit notes to vehicle owners
MESSAGING_VISIT_MESSAGES=on

# Contact-form messages allowed per IP address every 15 minutes
LEAD_RATE_LIMIT_MAX=5

# Requests allowed per IP address per minute across the whole API
API_RATE_LIMIT_MAX=600

# How many proxies sit in front of the server in production (0 to 5; default 1). Used to find the caller's real IP
# address for the rate limits and the audit log. Render alone: 1. A CDN (for example Cloudflare) in front of Render: 2.
# Too low puts everyone behind one address; too high lets a caller choose their own address.
TRUST_PROXY=1

# Set to true in production if your host does not redirect http to https itself
FORCE_HTTPS=false

# Used only by "npm run restore" to test a backup. The database name must end
# with _restore. Never point it at your live database.
MONGO_URI_RESTORE=

# ---- Plan purchases and GST invoices (Dashboard > Billing) ----
# Buying a plan needs a real payment gateway (PAYMENT_PROVIDER=razorpay, or simulated while testing)
# and the seller details below. Until SELLER_NAME, SELLER_ADDRESS and SELLER_STATE are filled the
# Billing page shows "not ready" and nothing can be bought. Ask your accountant for SELLER_GSTIN
# and SELLER_SAC (the service code printed on the invoice); they are left empty on purpose.
SELLER_NAME=
SELLER_GSTIN=
SELLER_ADDRESS=
# State of the seller, e.g. Karnataka (decides CGST+SGST for buyers in the same state, IGST otherwise)
SELLER_STATE=
SELLER_SAC=
# Where "Reply" on an invoice email goes (optional)
SELLER_EMAIL=
# Invoice numbers look like SP/26-27/00001 (prefix / financial year / running number)
INVOICE_PREFIX=SP
# Hours a plan payment link stays open (default 24)
BILLING_LINK_HOURS=24

# ---- Mobile-OTP signup ----
# on: new companies must verify their mobile number with a code sent by SMS before registering.
# Needs MESSAGING_PROVIDER=twilio (or simulated while testing). Default off.
SIGNUP_OTP=off

# ---- Hardware shop (Dashboard > Hardware Shop; see docs/shop.md) ----
# Uses the same payment gateway and SELLER_* details as plan purchases.
# Flat delivery charge per order in rupees before GST. 0 = delivery is included in the prices.
SHOP_SHIPPING_FLAT=0
# Goods worth at least this much (before GST) ship free. 0 = no free-delivery rule.
SHOP_FREE_SHIPPING_ABOVE=0
# GST rate on the delivery charge (0, 5, 12, 18 or 28) and the service code printed for it
SHOP_SHIPPING_GST=18
SHOP_SHIPPING_SAC=
# Order numbers look like HW/26-27/0001
SHOP_ORDER_PREFIX=HW
# Hours a shop payment link stays open (default 24)
SHOP_LINK_HOURS=24
# Who is emailed when an order is paid (default: SELLER_EMAIL)
SHOP_NOTIFY_EMAIL=

# ---- Prepaid wallets (Dashboard > Wallets; see docs/wallets.md) ----
# The most a wallet may hold, in rupees (default 50000).
WALLET_MAX_BALANCE=50000

# ---- FASTag charging (see docs/fastag.md) ----
# Taking a parking fee from the customer's FASTag needs a bank / NETC acquirer that has signed with you.
#   none       (default) nothing is charged; FASTAG stays a payment method the operator records
#   simulated  pretend partner for trying the screens (never in production). Tag ids ending in F are
#              declined; ending in U are "unknown" for about 5 seconds, then succeed.
#   http       your partner's API, shaped like the contract in docs/fastag.md
# While a real provider is on, "FASTag" at the exit always charges the tag (it can no longer be just recorded).
FASTAG_PROVIDER=none
FASTAG_API_URL=
FASTAG_API_KEY=
FASTAG_TIMEOUT_MS=8000

# Reports: dates in the last N days are the "Current" period, anything older is "Old" (default 90)
REPORT_CURRENT_DAYS=90
