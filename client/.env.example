# Copy this file to .env and fill in what you use. Restart `npm run dev` after changing it.

# The address of the live website, with no slash at the end. Used for sitemap.xml when you run `npm run build`.
# VITE_SITE_URL=https://www.example.com

# Google Maps (optional). A browser key with "Maps JavaScript API", "Geocoding API" and "Maps Embed API" turned on.
# Restrict it to your website addresses in Google Cloud. Without it the map picker falls back to typed coordinates.
# VITE_GOOGLE_MAPS_KEY=
# A Map ID from Google Cloud (optional; a demo one is used when empty).
# VITE_GOOGLE_MAPS_MAP_ID=
