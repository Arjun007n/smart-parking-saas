# Copy this file to app.env and fill it in. app.env is private (it is in .gitignore).

# The address of your Smart Parking server, WITHOUT /api at the end.
#   Production:                 https://api.your-site.example
#   Test on the Android emulator, server running on this PC:   http://10.0.2.2:5000
#   Test on a real phone, server running on this PC:           http://192.168.1.50:5000  (this PC's address on your Wi-Fi)
API_URL=https://api.your-site.example

# 1 = test mode: allows a plain http server address (never use for a release build). Leave empty for production.
APP_DEV=
